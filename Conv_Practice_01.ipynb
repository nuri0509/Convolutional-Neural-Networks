     ]
    }
   ],
   "source": [
    "# Pooling 적용하기\n",
    "input_tensor = Input(shape=(28, 28, 1))\n",
    "x = Conv2D(filters=16, kernel_size=3, strides=1, padding='same', activation='relu')(input_tensor)\n",
    "print('x type:',  type(x), 'x:', x)"
